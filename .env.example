DEEPSEEK_API_KEY="YOUR_KEY_HERE"
ANTHROPIC_API_KEY="YOUR_KEY_HERE"
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD=""
COMPASS_API_URL="https://compass-engine-production-532b.up.railway.app"
OPENCLI_PROFILE="2dsmkwnt"

# ── Compass Evidence Agent ──────────────────────────────────────────────
# LLM provider: "deepseek" or "anthropic"
LLM_PROVIDER="deepseek"
# Budget ceilings in USD (daily must be <= total)
AGENT_MAX_DAILY_LLM_USD=0.50
AGENT_MAX_TOTAL_LLM_USD=3.75
AGENT_LLM_CONCURRENCY=2
AGENT_MAX_DOCS_PER_CYCLE=10
AGENT_SLEEP_SECONDS=900
AGENT_AUTO_PUBLISH=false
# Shared secret for engine sync — set the SAME value on both the agent and the
# engine service so POST /api/evidence/enrichment accepts agent writes.
# AGENT_SYNC_TOKEN=""
# Optional: JSON file for persistent daily/total budget spend (no Railway volume required)
# AGENT_STATE_FILE="/app/data/agent_state.json"
# Optional: SQLite path for persistent claims/enrichment results (recommend a volume)
# AGENT_STORE_DB="/app/data/agent_store.db"
# Collector DB for enrichment candidates. If unset, the agent downloads the
# real collector_v3.db at startup (it is excluded from the Railway build and
# ships as a git-lfs pointer). Point this at a Railway volume to avoid
# re-downloading on every restart.
# AGENT_CANDIDATE_DB="/data/collector_v3.db"
# Set to 0 to disable the startup download (enrichment stays inactive).
AGENT_AUTO_DOWNLOAD_DB=true
# FetchFox browser acquisition (Source Library strategy for JS-heavy customer
# stories). Requires an AI provider key for extraction (OpenAI recommended):
# OPENAI_API_KEY=""
# Optional override of the FetchFox AI model string (default openai:gpt-4o-mini):
# FETCHFOX_AI="openai:gpt-4o-mini"
